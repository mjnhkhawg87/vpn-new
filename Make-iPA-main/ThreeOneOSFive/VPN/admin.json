  "log": { "level": "warn", "timestamp": true },
  "dns": {
    "servers": [{ "type": "local", "tag": "local" }],
    "rules": [
      { "domain": ["login.common.freefiremobile.com", "client.common.freefiremobile.com", "version.common.freefiremobile.com", "auth.garena.com", "accounts.google.com", "accounts.youtube.com", "oauth2.googleapis.com", "oauthaccountmanager.googleapis.com"], "action": "route", "server": "local" },
      { "domain_suffix": ["googleapis.com", "gstatic.com", "googleusercontent.com"], "action": "route", "server": "local" },
      { "domain_suffix": ["freefiremobile.com", "freefireth.com", "ff.garena.com"], "action": "reject", "method": "default", "no_drop": true }
