  }],
  "outbounds": [{ "type": "direct", "tag": "direct" }],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      { "protocol": "dns", "action": "hijack-dns" },
      { "action": "sniff", "sniffer": ["http", "tls", "quic"], "timeout": "1s" },
      { "domain": ["login.common.freefiremobile.com", "client.common.freefiremobile.com", "version.common.freefiremobile.com", "auth.garena.com", "accounts.google.com", "accounts.youtube.com", "oauth2.googleapis.com", "oauthaccountmanager.googleapis.com"], "action": "route", "outbound": "direct" },
      { "domain_suffix": ["googleapis.com", "gstatic.com", "googleusercontent.com"], "action": "route", "outbound": "direct" },
      { "domain_suffix": ["freefiremobile.com", "freefireth.com", "ff.garena.com"], "action": "reject", "method": "default", "no_drop": true },
      { "domain": ["client.ind.freefiremobile.com", "client.advance.freefiremobile.com", "ff.rtc.grtc.garenanow.com", "ff.sdk.grtc.garenanow.com", "ff.dr.grtc.garenanow.com", "dl.cdn.freefiremobile.com", "dl.dir.freefiremobile.com", "dl.aw.freefiremobile.com", "dl.castle.freefiremobile.com", "dl.ctl.freefiremobile.com", "dl.ctlin.freefiremobile.com", "dl.cvs.freefiremobile.com", "dl.gmc.freefiremobile.com", "dl.gcp.freefiremobile.com", "dl.hw.freefiremobile.com", "dl.ks.freefiremobile.com", "cdn.garenanow.com", "dl.garenanow.com", "cdn.gxx.garenanow.com", "dl.hdltw.garenanow.com", "gin.freefiremobile.com", "common.freefiremobile.com"], "action": "reject", "method": "default", "no_drop": true },
